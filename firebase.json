{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            ".firebaserc",
            "**/node_modules/**",
            "admin-tools/**",
            ".env",
            ".git/**",
            "server.js",
            "package.json",
            "package-lock.json",
            "venv/**",
            "venv_10/**",
            "model_import/**",
            "calibration_image_sample_data_20x128x128x3_float32.npy",
            "*.npy",
            "PROJECT_SPEC.md",
            ".gitignore",
            ".DS_Store"
        ],
        "headers": [
            {
                "source": "assets/model/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable, no-transform"
                    }
                ]
            },
            {
                "source": "sw.js",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "env.js",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-store, no-cache, must-revalidate"
                    }
                ]
            },
            {
                "source": "**/*.js",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600"
                    }
                ]
            },
            {
                "source": "**/*.css",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600"
                    }
                ]
            },
            {
                "source": "**/*.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "assets/icons/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}